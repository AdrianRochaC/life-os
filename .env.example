# Backend (para correr npm run start:dev en local)
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200,http://localhost:8080
MONGODB_URI=mongodb://localhost:27017/life-os

# Autenticación (JWT)
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Docker Compose
# Por defecto apunta al servicio "mongo" incluido en docker-compose.yml.
# Si quieres que el backend en Docker use TU MongoDB local de Windows, cambia a:
#   DOCKER_MONGODB_URI=mongodb://host.docker.internal:27017/life-os
DOCKER_MONGODB_URI=mongodb://mongo:27017/life-os

MONGO_HOST_PORT=27018
BACKEND_HOST_PORT=3000
FRONTEND_HOST_PORT=8080
